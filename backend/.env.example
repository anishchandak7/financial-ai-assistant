# Gemini API Key (Required)
GEMINI_KEY="your-gemini-api-key-here"

# Model Configurations (JSON format)
LLM_CONFIGS='[{"display_name":"Gemini3.6Flash","model_name":"gemini-3.6-flash"}]'

# Chroma Vector Store Path
CHROMA_DB_PATH="vectorstore/chromadb"

# Vector Store Collection Names (Comma-separated)
COLLECTION_NAMES="Finance, Portfolio, MarketAnalysis, Goals, News, Tax"

# Market Overview Configuration
MARKETS="US, GB, ASIA, EUROPE, RATES, COMMODITIES, CURRENCIES, CRYPTOCURRENCIES"

# LangSmith Observability & Tracing (Recommended for Production)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY="your-langsmith-api-key-here"
LANGSMITH_PROJECT="financial-ai-assistant"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"

